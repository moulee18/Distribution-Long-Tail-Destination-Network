# IncuBrix Distribution Hub — Environment Configuration Example
# Copy to .env and adjust values as needed. No paid API keys are required for Simulation Mode or testing.

PROJECT_NAME="IncuBrix Distribution Hub"
ENVIRONMENT=development
DEBUG=false
SIMULATION_MODE=true

# Security & Signing Secrets (Replace in production)
SECRET_KEY=replace-with-secure-32-byte-secret-key-in-production
WEBHOOK_SIGNING_SECRET=incubrix-default-webhook-signing-secret

# Database (PostgreSQL in Docker Compose; SQLite supported for standalone local runs)
POSTGRES_USER=incubrix
POSTGRES_PASSWORD=incubrix_secret
POSTGRES_DB=incubrix_db
DATABASE_URL=postgresql+asyncpg://incubrix:incubrix_secret@localhost:5432/incubrix_db
DATABASE_URL_SYNC=postgresql+psycopg2://incubrix:incubrix_secret@localhost:5432/incubrix_db

# Redis & Celery Background Jobs
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# MinIO / S3-Compatible Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_NAME=incubrix-distribution

# Local Test Instance Endpoints
MOCK_PLATFORM_BASE_URL=http://localhost:8001
LEMMY_INSTANCE_URL=http://localhost:8536
GHOST_ADMIN_API_URL=http://localhost:2368
PARTNER_WEBHOOK_URL=http://localhost:8001/mock/webhook/receiver

# Swappable AI Provider (mock | openai | anthropic | gemini)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL_NAME=incubrix-tailor-v1

# Operational Bounds & Thresholds
CONSECUTIVE_FAILURE_LIMIT=5
CERTIFICATION_RETENTION_MINUTES=10
RECERTIFICATION_INTERVAL_DAYS=30
